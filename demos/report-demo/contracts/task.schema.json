{
  "type": "object",
  "$id": "urn:agent-hub:report-demo:1:task",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "required": [
    "execution_profile",
    "schema_version",
    "task_id",
    "graph_revision",
    "status",
    "generation",
    "graph",
    "graph_digest",
    "runtime_spec_digest",
    "pause_requested",
    "nodes",
    "created_at"
  ],
  "properties": {
    "approved_by": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "delivery_receipts": {
      "type": "array",
      "items": true
    },
    "execution_profile": {
      "type": "string"
    },
    "generation": {
      "type": "string"
    },
    "graph": {
      "type": "object",
      "required": [
        "goal",
        "material_id",
        "focus",
        "nodes",
        "catalog_digest",
        "policy_version"
      ],
      "properties": {
        "catalog_digest": {
          "type": "string"
        },
        "focus": {
          "type": "string",
          "description": "Supported focus is exactly business or business+quality."
        },
        "goal": {
          "type": "string"
        },
        "material_id": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "expert",
              "role",
              "task"
            ],
            "properties": {
              "condition": {
                "type": [
                  "null",
                  "object"
                ],
                "required": [
                  "step",
                  "outcome"
                ],
                "properties": {
                  "outcome": {
                    "type": "string"
                  },
                  "step": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              "depends_on": {
                "type": "array",
                "description": "Predecessor node IDs. Omit or use an empty array only for the material extractor root; all other roles require their typed data dependencies.",
                "items": {
                  "type": "string"
                }
              },
              "expert": {
                "type": "string"
              },
              "id": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "task": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "policy_version": {
          "type": "string"
        },
        "selection": {
          "type": [
            "null",
            "object"
          ],
          "required": [
            "id",
            "digest"
          ],
          "properties": {
            "digest": {
              "type": "string"
            },
            "id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "graph_digest": {
      "type": "string"
    },
    "graph_revision": {
      "type": "string"
    },
    "identity_contract": {
      "type": "string"
    },
    "model_binding_digest": {
      "type": "string"
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "null",
          "object"
        ],
        "required": [
          "status",
          "attempt"
        ],
        "properties": {
          "attempt": {
            "type": "integer"
          },
          "input_digest": {
            "type": "string"
          },
          "owner_epoch": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "result": {
            "type": [
              "null",
              "object"
            ],
            "required": [
              "node_id",
              "input_digest",
              "artifact_id",
              "artifact_digest",
              "receipt",
              "valid",
              "output"
            ],
            "properties": {
              "artifact_digest": {
                "type": "string"
              },
              "artifact_id": {
                "type": "string"
              },
              "identity": {
                "type": "object",
                "$id": "https://agent-festival.local/schema/identity/0.2.0",
                "description": "Three-layer business identity (NGA §7.2). Retries/recovery reuse operation_id; a new evaluation under new versions is a new evaluation_revision linked to the same business_request_id.",
                "required": [
                  "business_request_id",
                  "operation_id"
                ],
                "properties": {
                  "business_request_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evaluation_revision": {
                    "type": "string",
                    "minLength": 1
                  },
                  "execution_generation": {
                    "type": "integer",
                    "description": "e — current execution ownership generation. Minted once per claim (hermes generation-stamp precedent: first opener wins). Renewal/takeover decisions belong to W04; Go stores the result. 0 = original claim; increments on verified takeover.",
                    "minimum": 0
                  },
                  "logical_execution": {
                    "type": "object",
                    "description": "o = (T, g, node_path, iteration_path) — the logical node execution identity (邢 GC#2 2026-11-13 formalization, adopted verbatim). T = the accepted task (business_request_id + graph_version); g = the adopted graph version/sha; node_path/iteration_path locate the node within the graph including loop/branch ordinals. operation_id remains the attempt (a) identity — o is the durable logical key that survives retries. All four fields required (atomic tuple — partial or empty logical_execution is invalid; M-1 fix): old events carry only operation_id (a-granularity); new events SHOULD carry logical_execution for graph-aware consumers (W04). See batch-0 scope (130/132号).",
                    "minProperties": 4,
                    "maxProperties": 4,
                    "required": [
                      "task_id",
                      "graph_version",
                      "node_path",
                      "iteration_path"
                    ],
                    "properties": {
                      "graph_version": {
                        "type": "string",
                        "description": "g — the adopted graph version/sha. Frozen at adoption by W04; Go stores but does not decide.",
                        "minLength": 1
                      },
                      "iteration_path": {
                        "type": "string",
                        "description": "Loop/branch ordinal path (e.g. 'iter:2' or 'loop:1/branch:B/iter:2'). Composes with node_path to form the full execution position.",
                        "minLength": 1
                      },
                      "node_path": {
                        "type": "string",
                        "description": "Path of the node within the graph (e.g. 'n3' or 'workflow/collection/n3' for nested). Nested/loop use parent path + ordinals.",
                        "minLength": 1
                      },
                      "task_id": {
                        "type": "string",
                        "description": "T — the accepted task identifier. In v0.1.0+1.0.0 this maps to business_request_id at the single-node level; graph-aware producers supply their own task identifier.",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": false
                  },
                  "operation_id": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              },
              "input_digest": {
                "type": "string"
              },
              "node_id": {
                "type": "string"
              },
              "output": true,
              "receipt": {
                "type": "string"
              },
              "reused_from": {
                "type": [
                  "null",
                  "object"
                ],
                "required": [
                  "task_id",
                  "node_id",
                  "receipt"
                ],
                "properties": {
                  "node_id": {
                    "type": "string"
                  },
                  "receipt": {
                    "type": "string"
                  },
                  "task_id": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              "valid": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "review": {
            "type": [
              "null",
              "object"
            ],
            "required": [
              "check_artifact",
              "object_digest",
              "decision",
              "reason",
              "principal",
              "receipt"
            ],
            "properties": {
              "check_artifact": {
                "type": "string"
              },
              "decision": {
                "type": "string"
              },
              "object_digest": {
                "type": "string"
              },
              "principal": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "receipt": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "skip_check": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "pause_requested": {
      "type": "boolean"
    },
    "report_approvals": {
      "type": "array",
      "items": true
    },
    "runtime_spec_digest": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
