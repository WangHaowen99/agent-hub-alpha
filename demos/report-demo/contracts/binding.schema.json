                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "ref": {
                  "type": "string"
                },
                "requires": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "requires_sections_any": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "schema": {
                  "type": "string"
                },
