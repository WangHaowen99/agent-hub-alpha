                  }
                }
              },
              "additionalProperties": false
            },
            "focus": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "input": {
              "type": [
                "null",
                "object"
              ],
              "required": [
                "schema"
              ],
              "properties": {
                "provides": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
