    "focus": "business+quality",
    "nodes": [
      {
        "id": "extract-cmb-2025",
        "expert": "extractor@1",
        "role": "年报资料提取",
        "task": "从固定材料 cmb-2025-annual-report-a 中提取招商银行股份有限公司本集团口径 2025 年与 2024 年的八项指标：revenue、net_profit_attributable、net_interest_margin、cost_to_income、npl_balance、npl_ratio、provision_coverage、cet1_ratio_advanced。逐项记录数值、单位、期间、口径与年报出处（章节/页码），缺失或口径不一致须显式标注，不得推算未披露数值。"
      },
      {
        "id": "biz-2025",
        "expert": "business@1",
        "role": "经营分析",
        "task": "基于 extract-cmb-2025 的指标提取结果，撰写本集团 2025 年对比 2024 年的经营分析段落，覆盖 revenue、net_profit_attributable、net_interest_margin、cost_to_income 四项指标的同比变化与成因解读。每处数值引用须标注来源，仅使用提取结果中的数值，不引入外部数据，不做超出材料范围的判断。",
        "depends_on": [
          "extract-cmb-2025"
        ]
      },
      {
        "id": "aq-2025",
        "expert": "quality@1",
        "role": "资产质量分析",
        "task": "基于 extract-cmb-2025 的指标提取结果，撰写本集团 2025 年对比 2024 年的资产质量分析段落，覆盖 npl_balance、npl_ratio、provision_coverage、cet1_ratio_advanced 四项指标的同比变化与风险含义。每处数值引用须标注来源，仅使用提取结果中的数值，不引入外部数据，不做超出材料范围的判断。",
        "depends_on": [
