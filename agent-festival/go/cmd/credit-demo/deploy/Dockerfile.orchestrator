ARG PYTHON_IMAGE=python:3.11-slim
FROM ${PYTHON_IMAGE} AS build
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-21-jdk-headless maven ca-certificates patch \
    && rm -rf /var/lib/apt/lists/*
ENV MAVEN_OPTS=-Xmx1536m
COPY go/cmd/credit-demo/deploy/maven_settings.py /tmp/maven_settings.py
COPY --from=solution-src pom.xml /src/solution/pom.xml
COPY --from=solution-src common/agent-core-ext-java /src/solution/common/agent-core-ext-java
COPY go/cmd/credit-demo/deploy/patches/blueprint-scheduler-drain.patch /tmp/blueprint-scheduler-drain.patch
RUN patch --batch --fuzz=0 -d /src/solution -p1 < /tmp/blueprint-scheduler-drain.patch
RUN --mount=type=cache,id=issue16-maven,target=/root/.m2 \
    python /tmp/maven_settings.py && \
    mvn -B -s /tmp/maven-settings.xml -f /src/solution/pom.xml -N -Drevision=0.1.3-aha-drain1 -Dmaven.test.skip=true install && \
    mvn -B -s /tmp/maven-settings.xml -f /src/solution/common/agent-core-ext-java/pom.xml \
      -pl agent-core-ext-orchestration -am -Drevision=0.1.3-aha-drain1 -Dmaven.test.skip=true install && rm /tmp/maven-settings.xml
COPY examples/credit-orchestrator /src/orchestrator
RUN --mount=type=cache,id=issue16-maven,target=/root/.m2 \
    python /tmp/maven_settings.py && \
    mvn -B -s /tmp/maven-settings.xml -f /src/orchestrator/pom.xml -DskipTests package && rm /tmp/maven-settings.xml
FROM ${PYTHON_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-21-jre-headless ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /src/orchestrator/target/credit-orchestrator.jar /app/credit-orchestrator.jar
EXPOSE 8195
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=65", "-jar", "/app/credit-orchestrator.jar"]
